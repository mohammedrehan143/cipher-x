# CIPHER-X Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# ── Copernicus Data Space Ecosystem (for auto-download) ────────────────────────
# Register free at: https://dataspace.copernicus.eu/
# Then create OAuth client at: https://identity.dataspace.copernicus.eu/
COPERNICUS_USERNAME=your_email@example.com
COPERNICUS_PASSWORD=your_password

# ── Project Paths (override defaults if needed) ─────────────────────────────────
# Default values are used if these are not set.
# BEFORE_DIR=data/sentinel/before
# AFTER_DIR=data/sentinel/after
# OUTPUT_DIR=outputs/maps
# PROCESSED_DIR=data/processed

# ── Processing Options ───────────────────────────────────────────────────────────
# MASK_CLASSES=0,1,3,8,9,10    # SCL classes to mask (comma-separated)
# OPEN_SIZE=3                  # Morphological opening kernel size
# CLOSE_SIZE=3                 # Morphological closing kernel size
